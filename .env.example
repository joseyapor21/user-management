MONGODB_URI=mongodb://user:password@host:27017/emergency?authSource=admin
JWT_SECRET=your-jwt-secret-change-in-production

# VAPID Keys for Web Push Notifications
# Generate your own with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-key-here
VAPID_PRIVATE_KEY=your-private-key-here

# Pusher - Real-time updates (like Google Docs)
# Get free credentials at https://pusher.com
PUSHER_APP_ID=your-app-id
NEXT_PUBLIC_PUSHER_KEY=your-key
PUSHER_SECRET=your-secret
NEXT_PUBLIC_PUSHER_CLUSTER=us2
